{
  "table": "AUDIT_LOG",
  "entity": "Журнал аудита",
  "description": "Кто, когда и какую операцию выполнил над сущностью",
  "columns": [
    {
      "name": "AUDIT_LOG_KEY",
      "type": "VARCHAR(256)"
    },
    {
      "name": "ENTITY_KEY",
      "type": "VARCHAR(256)"
    },
    {
      "name": "ENTITY_TYPE",
      "type": "VARCHAR(50)",
      "description": "тип сущности"
    },
    {
      "name": "OPERATION_TYPE",
      "type": "VARCHAR(50)",
      "description": "тип операции"
    },
    {
      "name": "ENTITY_VERSION",
      "type": "INT"
    },
    {
      "name": "ENTITY_VALUE_TYPE",
      "type": "SMALLINT"
    },
    {
      "name": "ENTITY_OPERATION_INTENT",
      "type": "SMALLINT"
    },
    {
      "name": "BATCH_OPERATION_KEY",
