    },
    {
      "name": "ELEMENT_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра элемента"
    },
    {
      "name": "JOB_KEY",
      "type": "BIGINT",
      "description": "ключ задания"
    },
    {
      "name": "USER_TASK_KEY",
      "type": "BIGINT",
      "description": "ключ пользовательской задачи"
    },
    {
      "name": "DECISION_REQUIREMENTS_KEY",
      "type": "BIGINT",
      "description": "ключ модели требований"
    },
    {
      "name": "DECISION_DEFINITION_KEY",
      "type": "BIGINT",
      "description": "ключ определения решения"
    },
    {
      "name": "DECISION_EVALUATION_KEY",
      "type": "BIGINT"
    },
    {
      "name": "DEPLOYMENT_KEY",
      "type": "BIGINT",
