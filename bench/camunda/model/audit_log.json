    },
    {
      "name": "TENANT_SCOPE",
      "type": "VARCHAR(50)"
    },
    {
      "name": "RESULT",
      "type": "VARCHAR(50)",
      "description": "результат",
      "values": [
        "SUCCESS",
        "FAIL"
      ]
    },
    {
      "name": "CATEGORY",
      "type": "VARCHAR(50)"
    },
    {
      "name": "PROCESS_DEFINITION_ID",
