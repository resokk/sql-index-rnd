    },
    {
      "name": "BATCH_OPERATION_TYPE",
      "type": "VARCHAR(50)"
    },
    {
      "name": "TIMESTAMP",
      "type": "TIMESTAMP(3) WITH TIME ZONE",
      "description": "время события"
    },
    {
      "name": "ACTOR_TYPE",
      "type": "VARCHAR(50)",
      "description": "тип исполнителя"
    },
    {
      "name": "ACTOR_ID",
