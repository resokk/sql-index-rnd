    },
    {
      "table": "DECISION_DEFINITION",
      "on": "DECISION_INSTANCE.DECISION_DEFINITION_KEY = DECISION_DEFINITION.DECISION_DEFINITION_KEY"
    },
    {
      "table": "DECISION_REQUIREMENTS",
      "on": "DECISION_INSTANCE.DECISION_REQUIREMENTS_KEY = DECISION_REQUIREMENTS.DECISION_REQUIREMENTS_KEY"
    },
    {
      "table": "FLOW_NODE_INSTANCE",
      "on": "DECISION_INSTANCE.FLOW_NODE_INSTANCE_KEY = FLOW_NODE_INSTANCE.FLOW_NODE_INSTANCE_KEY"
    },
    {
      "table": "TENANT",
      "on": "DECISION_INSTANCE.TENANT_ID = TENANT.TENANT_ID"
    }
  ]
