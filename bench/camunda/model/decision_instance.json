{
  "table": "DECISION_INSTANCE",
  "entity": "Вычисление решения",
  "description": "Результат вычисления DMN-решения",
  "columns": [
    {
      "name": "DECISION_INSTANCE_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор вычисления решения"
    },
    {
      "name": "DECISION_INSTANCE_KEY",
      "type": "BIGINT"
    },
    {
      "name": "PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра процесса"
    },
    {
      "name": "ROOT_PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ корневого экземпляра процесса"
    },
    {
      "name": "PROCESS_DEFINITION_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор процесса (BPMN id)"
    },
    {
      "name": "PROCESS_DEFINITION_KEY",
      "type": "BIGINT",
      "description": "ключ определения процесса"
    },
    {
      "name": "DECISION_DEFINITION_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор решения"
    },
    {
      "name": "DECISION_DEFINITION_KEY",
      "type": "BIGINT",
      "description": "ключ определения решения"
    },
    {
      "name": "DECISION_REQUIREMENTS_ID",
      "type": "VARCHAR(256)"
    },
    {
      "name": "DECISION_REQUIREMENTS_KEY",
      "type": "BIGINT",
      "description": "ключ модели требований"
    },
    {
      "name": "FLOW_NODE_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор элемента BPMN"
    },
    {
      "name": "FLOW_NODE_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра элемента"
    },
    {
      "name": "ROOT_DECISION_DEFINITION_KEY",
      "type": "BIGINT"
    },
    {
      "name": "EVALUATION_DATE",
      "type": "TIMESTAMP(3) WITH TIME ZONE",
      "description": "дата вычисления"
    },
    {
      "name": "TYPE",
      "type": "VARCHAR(255)",
      "description": "тип"
    },
    {
      "name": "STATE",
      "type": "VARCHAR(255)",
      "description": "состояние",
      "values": [
        "EVALUATED",
        "FAILED"
      ]
    },
    {
      "name": "RESULT",
      "type": "VARCHAR(256)",
      "description": "результат"
    },
    {
      "name": "EVALUATION_FAILURE",
      "type": "VARCHAR(256)"
    },
    {
      "name": "EVALUATION_FAILURE_MESSAGE",
      "type": "VARCHAR(4000)",
      "description": "текст ошибки вычисления"
    },
    {
      "name": "TENANT_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор тенанта"
    },
    {
      "name": "PARTITION_ID",
      "type": "BIGINT",
      "description": "номер партиции"
    },
    {
      "name": "HISTORY_CLEANUP_DATE",
      "type": "TIMESTAMP(3) WITH TIME ZONE"
    },
    {
      "name": "FULL_RESULT",
      "type": "TEXT"
    },
    {
      "name": "BUSINESS_ID",
      "type": "VARCHAR(256)",
      "description": "бизнес-идентификатор"
    }
