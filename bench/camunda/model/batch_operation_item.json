{
  "table": "BATCH_OPERATION_ITEM",
  "entity": "Элемент пакетной операции",
  "description": "Отдельный объект, обрабатываемый пакетной операцией",
  "columns": [
    {
      "name": "BATCH_OPERATION_KEY",
      "type": "VARCHAR(255)",
      "description": "ключ пакетной операции"
    },
    {
      "name": "ITEM_KEY",
      "type": "BIGINT"
    },
    {
      "name": "PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра процесса"
    },
    {
      "name": "ROOT_PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ корневого экземпляра процесса"
    },
    {
      "name": "PROCESSED_DATE",
      "type": "TIMESTAMP(3) WITH TIME ZONE"
    },
    {
      "name": "ERROR_MESSAGE",
      "type": "VARCHAR(4000)",
      "description": "текст ошибки"
    },
    {
      "name": "STATE",
      "type": "VARCHAR(20)",
      "description": "состояние",
      "values": [
        "ACTIVE",
        "COMPLETED",
        "CANCELED",
        "FAILED"
      ]
    }
  ],
  "relations": [
    {
      "table": "BATCH_OPERATION",
      "on": "BATCH_OPERATION_ITEM.BATCH_OPERATION_KEY = BATCH_OPERATION.BATCH_OPERATION_KEY"
    },
    {
      "table": "PROCESS_INSTANCE",
      "on": "BATCH_OPERATION_ITEM.PROCESS_INSTANCE_KEY = PROCESS_INSTANCE.PROCESS_INSTANCE_KEY"
    },
    {
      "table": "PROCESS_INSTANCE",
      "on": "BATCH_OPERATION_ITEM.ROOT_PROCESS_INSTANCE_KEY = PROCESS_INSTANCE.PROCESS_INSTANCE_KEY"
    }
  ]
}
