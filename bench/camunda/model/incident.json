{
  "table": "INCIDENT",
  "entity": "Инцидент",
  "description": "Ошибка при выполнении процесса, требующая вмешательства",
  "columns": [
    {
      "name": "INCIDENT_KEY",
      "type": "BIGINT",
      "description": "ключ инцидента"
    },
    {
      "name": "FLOW_NODE_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра элемента"
    },
    {
      "name": "FLOW_NODE_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор элемента BPMN"
    },
    {
      "name": "PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ экземпляра процесса"
    },
    {
      "name": "ROOT_PROCESS_INSTANCE_KEY",
      "type": "BIGINT",
      "description": "ключ корневого экземпляра процесса"
    },
    {
      "name": "PROCESS_DEFINITION_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор процесса (BPMN id)"
    },
    {
      "name": "PROCESS_DEFINITION_KEY",
      "type": "BIGINT",
      "description": "ключ определения процесса"
    },
    {
      "name": "ERROR_MESSAGE",
      "type": "VARCHAR(4000)",
      "description": "текст ошибки"
    },
    {
      "name": "ERROR_MESSAGE_HASH",
      "type": "INT"
    },
    {
      "name": "ERROR_TYPE",
      "type": "VARCHAR(100)",
      "description": "тип ошибки",
      "values": [
        "JOB_NO_RETRIES",
        "EXTRACT_VALUE_ERROR",
        "CALLED_ELEMENT_ERROR",
        "UNHANDLED_ERROR_EVENT",
        "DECISION_EVALUATION_ERROR",
        "IO_MAPPING_ERROR"
      ]
    },
    {
      "name": "STATE",
      "type": "VARCHAR(20)",
      "description": "состояние",
      "values": [
        "ACTIVE",
        "RESOLVED",
        "MIGRATED",
        "PENDING"
      ]
    },
    {
      "name": "CREATION_DATE",
      "type": "TIMESTAMP(3) WITH TIME ZONE",
      "description": "дата создания"
    },
    {
      "name": "TREE_PATH",
      "type": "VARCHAR(8191)"
    },
    {
      "name": "TENANT_ID",
      "type": "VARCHAR(256)",
      "description": "идентификатор тенанта"
    },
    {
      "name": "JOB_KEY",
      "type": "BIGINT",
      "description": "ключ задания"
    },
    {
      "name": "PARTITION_ID",
      "type": "BIGINT",
      "description": "номер партиции"
    }
  ],
  "relations": [
    {
      "table": "FLOW_NODE_INSTANCE",
      "on": "INCIDENT.FLOW_NODE_INSTANCE_KEY = FLOW_NODE_INSTANCE.FLOW_NODE_INSTANCE_KEY"
    },
    {
      "table": "PROCESS_INSTANCE",
      "on": "INCIDENT.PROCESS_INSTANCE_KEY = PROCESS_INSTANCE.PROCESS_INSTANCE_KEY"
    },
    {
      "table": "PROCESS_INSTANCE",
      "on": "INCIDENT.ROOT_PROCESS_INSTANCE_KEY = PROCESS_INSTANCE.PROCESS_INSTANCE_KEY"
    },
    {
      "table": "PROCESS_DEFINITION",
      "on": "INCIDENT.PROCESS_DEFINITION_KEY = PROCESS_DEFINITION.PROCESS_DEFINITION_KEY"
    },
    {
      "table": "TENANT",
      "on": "INCIDENT.TENANT_ID = TENANT.TENANT_ID"
    },
    {
      "table": "JOB",
      "on": "INCIDENT.JOB_KEY = JOB.JOB_KEY"
    }
  ]
}
