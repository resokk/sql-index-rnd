    },
    {
      "table": "PROCESS_INSTANCE",
      "on": "VARIABLE.ROOT_PROCESS_INSTANCE_KEY = PROCESS_INSTANCE.PROCESS_INSTANCE_KEY"
    },
    {
      "table": "TENANT",
      "on": "VARIABLE.TENANT_ID = TENANT.TENANT_ID"
    },
    {
      "table": "FLOW_NODE_INSTANCE",
      "on": "VARIABLE.ELEMENT_INSTANCE_KEY = FLOW_NODE_INSTANCE.FLOW_NODE_INSTANCE_KEY"
    }
  ]
}
